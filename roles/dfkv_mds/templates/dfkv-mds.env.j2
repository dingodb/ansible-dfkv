# Managed by Ansible. Version-independent: the launcher in current/ reads this
# file, so a release flip changes the binary without rewriting node wiring.
#
# LISTEN and ETCD have no defaults in the launcher on purpose -- a missing value
# there is fatal rather than silent.

LISTEN={{ dfkv_mds_listen_port }}

# host:port, no scheme. dfkv_mds adds it; a scheme here yields
# http://http://... and every etcd call fails.
ETCD={{ dfkv_mds_etcd }}

METRICS_PORT={{ dfkv_mds_metrics_port }}
METRICS_BIND={{ dfkv_mds_metrics_bind }}
{% if dfkv_mds_accept_legacy %}
# Epoch shim during a migration. Remove once dfkv_mds_legacy_frames_total stops
# increasing; leaving it set keeps old clients alive indefinitely.
DFKV_MDS_ACCEPT_LEGACY=1
{% endif %}
