# Managed by Ansible.
#
# The upstream docker-compose.yml reads every one of these, so a region's
# differences live here rather than in a re-rendered compose file.
#
# Only OTLP is bound to a cluster-reachable address: connectors push to it from
# the GPU nodes. Everything else stays on loopback unless the region says
# otherwise -- Prometheus, Tempo and Grafana have no authentication of their own
# beyond Grafana's login.

DFKV_OTLP_GRPC_PORT={{ dfkv_observability_otlp_grpc_port }}
DFKV_OTLP_HTTP_PORT={{ dfkv_observability_otlp_http_port }}
DFKV_COLLECTOR_HEALTH_PORT={{ dfkv_observability_collector_health_port }}
DFKV_COLLECTOR_PROM_PORT={{ dfkv_observability_collector_prom_port }}
DFKV_PROMETHEUS_PORT={{ dfkv_observability_prometheus_port }}
DFKV_TEMPO_PORT={{ dfkv_observability_tempo_port }}
DFKV_GRAFANA_PORT={{ dfkv_observability_grafana_port }}

# Required by the upstream compose file, which refuses to start without it
# rather than falling back to a default admin password.
DFKV_GRAFANA_ADMIN_PASSWORD={{ dfkv_observability_grafana_password }}
