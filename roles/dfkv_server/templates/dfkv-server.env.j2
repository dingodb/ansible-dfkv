# Managed by Ansible. Version-independent: the launcher in current/ reads this
# file, so a release flip changes the binary without rewriting node wiring, and
# node tuning can change without staging a release.
#
# Every value here is *this node's own*. The rollout this replaces kept per-node
# values as region-wide strings -- SERVER_CAP_MAP="n1:1;n2:2" -- matched against
# $(hostname) inside the launcher. That worked, but it meant the key had to be
# the OS hostname while every other map keyed on the inventory name, and hd04's
# cap map was written with k8s names, so it silently did nothing. Here the
# per-node values are ordinary host variables and there is nothing to mismatch.
#
# This file is sourced by the launcher, so values are quoted.

GROUP="{{ dfkv_group }}"
MDS="{{ dfkv_mds_endpoints }}"

# Derived from the disks this node measured, not written by hand: the smallest
# disk in the selected same-size group x dfkv_disk_usage_ratio, rounded down to
# a whole 1 GiB extent, times the number of disks. See tasks/select_disks.yml.
CAP={{ dfkv_effective_cap | int }}
# Defaults to the number of selected disks, which is proportional to this
# node's capacity under the ratio model. Override dfkv_weight to pin it.
WEIGHT={{ dfkv_effective_weight }}
PORT={{ dfkv_server_port }}
RDMA_PORT={{ dfkv_server_rdma_port }}
METRICS_PORT={{ dfkv_server_metrics_port }}
METRICS_BIND="{{ dfkv_server_metrics_bind }}"
# Resolved from dfkv_rdma_dev against this node's actual devices, so a
# pattern like "ib7s400p*" yields 8 rails here and 4 on a node with fewer.
RDMA_DEV="{{ dfkv_rdma_dev_resolved | join(',') }}"
ADV_IFACE="{{ dfkv_advertise_iface }}"
DISK_SUBDIR="{{ dfkv_disk_subdir }}"
# Always explicit, never left to the launcher's glob: the selection may have
# deliberately excluded a disk that is not the same size as the rest, and a glob
# would put it straight back.
SERVER_DISKS="{{ dfkv_server_disk_selection.indices | join(',') }}"
STORE_ENGINE="{{ dfkv_store_engine }}"
SLAB_WRITE="{{ dfkv_slab_write }}"
RDMA_DEPTH={{ dfkv_rdma_depth }}
RDMA_RECV_SEGMENT_SIZE={{ dfkv_rdma_recv_segment_size }}
RDMA_RECV_CHUNK_BYTES={{ dfkv_rdma_recv_chunk_bytes }}
DFKV_RDMA_RECV_CHUNK_IDLE_MS={{ dfkv_rdma_recv_chunk_idle_ms }}
MAX_MSG={{ dfkv_max_msg }}
# One weight for every disk -- dfkv's CLI has no per-disk form for this. It is
# capacity-proportional precisely because select_disks.yml hands dfkv a set of
# equal-size disks, so there is nothing to weight differently.
DISK_HASH_WEIGHT={{ dfkv_disk_hash_weight }}
READ_COALESCE={{ dfkv_read_coalesce }}
MDS_REGISTRATION_TIMEOUT_MS={{ dfkv_mds_registration_timeout_ms }}
DFKV_SLAB_EVICT_HIGH_PCT={{ dfkv_slab_evict_high_pct }}
DFKV_SLAB_EVICT_LOW_PCT={{ dfkv_slab_evict_low_pct }}
DFKV_SLAB_EVICT_MAX_EXTENTS_PER_TICK={{ dfkv_slab_evict_max_extents_per_tick }}
{% if dfkv_ram_tier | bool %}
RAM_TIER=on
RAM_TIER_BYTES={{ dfkv_ram_tier_bytes | int }}
RAM_TIER_SHARDS={{ dfkv_ram_tier_shards | default(16) }}
{% else %}
RAM_TIER=off
{% endif %}
